# Env matrix for apps/fe (Nuxt 4 app). See
# plans/twinkly-shimmying-marshmallow.md ("Env / deploy matrix") for the full
# table of which vars apply to prod (static generate) vs preview (SSR) vs
# local dev.

# --- Sanity project (shared across all deploy targets) ---
SANITY_PROJECT_ID=0in4i1po
SANITY_DATASET=production
SANITY_API_VERSION=2023-10-10

# --- SEO / canonical base URL ---
# Absolute site origin used for canonical/og:url tags, sitemap.xml, and
# robots.txt (server/utils/site-url.ts). Optional on Vercel — the build
# falls back to VERCEL_PROJECT_PRODUCTION_URL (the production domain), then
# VERCEL_URL. Set explicitly when a custom domain exists, or for local
# builds that need absolute URLs. No trailing slash.
# SITE_URL=https://example.com

# --- Preview / Visual Editing only (unset in prod static builds) ---
# Viewer-scoped read token — required for SSR preview (drafts perspective),
# only needed locally when testing preview mode.
# SANITY_READ_TOKEN=

# Studio URL the stega-encoded overlay data points back to — required (hard
# fail) when NUXT_PUBLIC_PREVIEW_ENABLED=true; defaults to the local Studio
# dev server otherwise.
# SANITY_STUDIO_URL=http://localhost:3333

# Enables the visual-editing plugin + preview Nitro routes. Must be unset (or
# "false") for the static prod build — Phase 6 gates plugins/scanDirs on this
# so preview code is structurally absent from `nuxt generate` output.
# NUXT_PUBLIC_PREVIEW_ENABLED=true

# HMAC secret for the preview session cookie. Falls back to a hash of
# SANITY_READ_TOKEN when unset.
# PREVIEW_SESSION_SECRET=

# Nitro deploy target for the SSR preview build (unset for the static prod
# build, which just runs `nuxt generate`).
# NITRO_PRESET=vercel
